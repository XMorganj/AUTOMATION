# --- Sign-in (required unless BASIC_AUTH_DISABLED=true) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# BASIC_AUTH_DISABLED=true   # local use only, never on a public server

# --- AI writing (ideas, script, fact check, prompts, title & SEO) ---
# Claude is the default.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=
# To use a local Ollama model instead, set DEFAULT_AI_PROVIDER=ollama and the lines below.
# DEFAULT_AI_PROVIDER=anthropic
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=huihui_ai/dolphin3-abliterated:8b-llama3.1-q4_K_M
# How much text the model can read at once. Ollama's own default is small and silently cuts long scripts.
# OLLAMA_NUM_CTX=16384

# --- Voiceover. Without it you get silent placeholder narration with realistic timing. ---
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- YouTube upload (step 10). Create these in console.cloud.google.com:
#     enable "YouTube Data API v3", set up the OAuth consent screen, then make an OAuth client ID of type "Web application".
#     Add the redirect address shown on the Upload screen, e.g. https://YOUR-SITE/api/youtube/callback ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the site sits behind a proxy that hides its real address:
# GOOGLE_REDIRECT_URI=https://YOUR-SITE/api/youtube/callback

# --- Where generated images, narration and music are kept (default ./data) ---
# STUDIO_DATA_DIR=

# --- Render ---
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# CAPTION_FONT=Poppins

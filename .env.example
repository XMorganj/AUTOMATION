# --- Sign-in (required unless BASIC_AUTH_DISABLED=true) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# BASIC_AUTH_DISABLED=true   # local use only, never on a public server

# --- AI writing (ideas, script, fact check, prompts, title & SEO) ---
# Claude is the default.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=
# To use a local Ollama model instead, set DEFAULT_AI_PROVIDER=ollama and the lines below.
# DEFAULT_AI_PROVIDER=anthropic
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=huihui_ai/dolphin3-abliterated:8b-llama3.1-q4_K_M
# How much text the model can read at once. Ollama's own default is small and silently cuts long scripts.
# OLLAMA_NUM_CTX=16384

# --- Voiceover. Without it you get silent placeholder narration with realistic timing. ---
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Where generated images, narration and music are kept (default ./data) ---
# STUDIO_DATA_DIR=

# --- Render ---
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# CAPTION_FONT=Poppins

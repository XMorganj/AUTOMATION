# --- Sign-in (required unless BASIC_AUTH_DISABLED=true) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# BASIC_AUTH_DISABLED=true   # local use only, never on a public server

# --- AI writing (ideas, script, fact check, prompts). Without it you get labelled placeholders. ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=

# --- Voiceover. Without it you get silent placeholder narration with realistic timing. ---
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# --- Where generated images, narration and music are kept (default ./data) ---
# STUDIO_DATA_DIR=
